# Telegram Bot API — dùng để gửi thông báo đơn hàng mới.
# KHÔNG commit file .env thật lên Git. Chỉ điền giá trị thật trong:
#  - .env.local khi chạy `next dev` ở máy local, hoặc
#  - mục "Environment variables" trong Cloudflare Pages dashboard khi deploy.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
